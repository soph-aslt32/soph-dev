{
    // フォントの設定
    // "editor.fontFamily": "'Monoid', 'Rounded Mgen+ 1mn'",
    // "editor.fontFamily": "'VL Gothic'",
    "editor.fontFamily": "'Juisee HWNF'",
    "terminal.integrated.fontSize": 16,
    "editor.fontSize": 14,
    // --------------

    // ---- workbench の設定 ----
    "workbench.editor.wrapTabs": true,
    "workbench.sash.size": 20,
    "editor.scrollbar.verticalScrollbarSize": 20,
    "editor.scrollbar.horizontalScrollbarSize": 15,
    "editor.scrollbar.horizontal": "hidden",
    "editor.wordWrap": "on",
    "workbench.colorCustomizations": {
        "sash.hoverBorder": "#f15dfc",
        "editorInlayHint.foreground": "#e8f7f050",
        // "editorInlayHint.background": "#3b76bf10",
        "editorInlayHint.parameterForeground": "#e8f7f050",
        // "editorInlayHint.parameterBackground": "#3b76bf10",
        "editorInlayHint.typeForeground": "#e8f7f050",
        // "editorInlayHint.typeBackground": "#3b76bf10",
        // インデントガイドラインの設定
        // "editorIndentGuide.background1": "#ffffff33",
        // "editorIndentGuide.background2": "#ffffff33",
        // "editorIndentGuide.background3": "#ffffff33",
        // "editorIndentGuide.background4": "#ffffff33",
        // "editorIndentGuide.background5": "#ffffff33",
        // "editorIndentGuide.background6": "#ffffff33",
        "editorIndentGuide.background1": "#5a58d350",
        "editorIndentGuide.background2": "#66bcf950",
        "editorIndentGuide.background3": "#20d83250",
        "editorIndentGuide.background4": "#e84a5a50",
        "editorIndentGuide.background5": "#e5c46250",
        "editorIndentGuide.background6": "#ff63e550",
        "editorIndentGuide.activeBackground1": "#5a58d3",
        "editorIndentGuide.activeBackground2": "#66bcf9",
        "editorIndentGuide.activeBackground3": "#20d832",
        "editorIndentGuide.activeBackground4": "#e84a5a",
        "editorIndentGuide.activeBackground5": "#e5c462",
        "editorIndentGuide.activeBackground6": "#ff63e5",
        // bracket pair colorization
        "editorBracketHighlight.foreground1": "#5a58d3",
        "editorBracketHighlight.foreground2": "#66bcf9",
        "editorBracketHighlight.foreground3": "#20d832",
        "editorBracketHighlight.foreground4": "#e84a5a",
        "editorBracketHighlight.foreground5": "#e5c462",
        "editorBracketHighlight.foreground6": "#ff63e5",
        "editorBracketPairGuide.background1": "#5a58d350",
        "editorBracketPairGuide.background2": "#66bcf950",
        "editorBracketPairGuide.background3": "#20d83250",
        "editorBracketPairGuide.background4": "#e84a5a50",
        "editorBracketPairGuide.background5": "#e5c46250",
        "editorBracketPairGuide.background6": "#ff63e550",
        "editorBracketPairGuide.activeBackground1": "#5a58d3",
        "editorBracketPairGuide.activeBackground2": "#66bcf9",
        "editorBracketPairGuide.activeBackground3": "#20d832",
        "editorBracketPairGuide.activeBackground4": "#e84a5a",
        "editorBracketPairGuide.activeBackground5": "#e5c462",
        "editorBracketPairGuide.activeBackground6": "#ff63e5",
    },
    // --------------------------

    // ------------ editorの設定 --------------
    "editor.guides.bracketPairs": "active",
    "editor.renderWhitespace": "all",
    "editor.suggest.showWords": false,
    // ----------------------------------------

    // ----- rust-analyzer -----
    "rust-analyzer.completion.autoimport.enable": false,
    // -------------------------

    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "security.workspace.trust.untrustedFiles": "open",
    "editor.detectIndentation": false,

    // ----- `Markdown` -----
    // MARK: `Markdown`
    "[markdown]": {
        "editor.tabSize": 2,
        "editor.wordWrap": "on",
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    },
    "markdownlint.config": {
        "MD024": {
            "siblings_only": true
        },
        "MD060": false,
        "MD025": false,
    },
    "markdown-preview-enhanced.previewTheme": "github-dark.css",
    // ----------------------

    // ----- `Python` -----
    "python.analysis.inlayHints.callArgumentNames": "partial",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.autoImportCompletions": false,
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.completeFunctionParens": true,
    // --------------------

    "window.openFilesInNewWindow": "on",

    // ----- `PlantUML` -----
    "[plantuml]": {
        "editor.wordWrap": "on",
    },
    // ----------------------

    // ----- `Todo Tree` -----
    // MARK: `Todo Tree`
    "better-todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
    "better-todo-tree.highlights.useColourScheme": false,
    "better-todo-tree.filtering.excludeGlobs": [
        // "**/node_modules/**",
        // "**/dist/**",
        "**/out/**",
        // "**/build/**",
        "**/.vscode/**",
        // "**/.git/**",
        // "**/.github/**",
        // "**/.cache/**",
        "**/.venv/**",
        "**/__pycache__/**",
    ],
    "better-todo-tree.highlights.defaultHighlight": {
        // "fontWeight": "bold",
        // "fontStyle": "italic",
        // "textDecoration": "underline",
        // "borderRadius": "",
        // "icon": "",
        // "iconColour": "",
        "gutterIcon": true,
        "rulerColour": "#00ACFA",
        // "rulerOpacity": 0,
        // "rulerLane": "right",
        "type": "text",
        "foreground": "#00ACFA",
        // "background": "#6564DB",
        // "opacity": 100,
    },
    "better-todo-tree.general.tags": [
        "TEST",
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "[ ]",
        // "[x]",
        "WIP",
        "PEND",
        "NOTE",
        "NOTES",
        "MARK",
        "WIP:AS",
        "TODO:AS",
        "PEND:AS",
        "NOTE:AS",
    ],
    "better-todo-tree.highlights.customHighlight": {
        "BUG": {
            "icon": "bug",
            // GoldenRod
            "rulerColour": "#DAA520",
            "foreground": "#DAA520",
        },
        "HACK": {
            "icon": "tools",
            // Coral
            "rulerColour": "#FF7F50",
            "foreground": "#FF7F50",
        },
        "FIXME": {
            "icon": "flame",
            // Yellow
            "rulerColour": "#FFFF00",
            "foreground": "#FFFF00",
        },
        "TODO": {
            "icon": "check-circle-fill",
            // Orange
            "rulerColour": "#FFA500",
            "foreground": "#FFA500",
            // "icon": "rocket"
        },
        "XXX": {
            "icon": "x",
            // Crimson
            "rulerColour": "#DC143C",
            "foreground": "#DC143C",
        },
        "[ ]": {
            "icon": "check",
            // LimeGreen
            "rulerColour": "#32CD32",
            "foreground": "#32CD32",
        },
        "[x]": {
            "icon": "issue-closed",
            // XXX
            // "rulerColour": "#008000",
            // "foreground": "#008000",
        },
        "WIP": {
            "icon": "zap",
            // Violet
            "rulerColour": "#EE82EE",
            "foreground": "#EE82EE",
        },
        "PEND": {
            "icon": "clock",
            // DarkGreen
            "rulerColour": "#006400",
            "foreground": "#006400",
        },
        "NOTE": {
            "icon": "paintbrush",
            // "rulerColour": "#FF0000",
            // "foreground": "#FF0000",
        },
        "NOTES": {
            "icon": "paintbrush",
            // "rulerColour": "#FF0000",
            // "foreground": "#FF0000",
        },
        "MARK": {
            "icon": "bookmark",
            // LightCoral
            "rulerColour": "#F08080",
            "rulerOpacity": 0,
            "foreground": "#F08080",
            // "background": "#F08080",
            // "borderRadius": "1px",
            "gutterIcon": false,
            "fontWeight": "bold",
        },
        // Additional custom highlights
        "WIP:AS": {
            "icon": "zap",
            "foreground": "#f23eda",
            "rulerColour": "#f23eda",
            "fontStyle": "italic",
            "textDecoration": "underline",
            "type": "text"
        },
        "TODO:AS": {
            "icon": "check-circle-fill",
            "foreground": "#dda863",
            "rulerColour": "#dda863",
            "fontStyle": "italic",
            "textDecoration": "underline",
            "type": "text"
        },
        "PEND:AS": {
            "icon": "clock",
            "foreground": "#151070",
            "rulerColour": "#151070",
            "fontStyle": "italic",
            "textDecoration": "underline",
            "type": "text"
        },
        "NOTE:AS": {
            "icon": "paintbrush",
            "foreground": "#7b24c1",
            "rulerColour": "#7b24c1",
            "fontStyle": "italic",
            "textDecoration": "underline",
            "type": "text"
        },
    },
    // -----------------------

    "editor.acceptSuggestionOnEnter": "off",
    "window.confirmSaveUntitledWorkspace": false,
    "hediet.vscode-drawio.resizeImages": null,
    "security.workspace.trust.enabled": false,

    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "latex": false,
    },
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "hediet.vscode-drawio.appearance": "light",
    "autoDocstring.docstringFormat": "numpy",

    // ----- ターミナル関係の設定 -----
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.mouseWheelScrollSensitivity": 0.5,
    "powershell.integratedConsole.showOnStartup": false,
    "github.copilot.nextEditSuggestions.enabled": true,

    // アイコンテーマ
    "workbench.iconTheme": "developer-icon-theme",
    "workbench.productIconTheme": "developer-icons",

    // MARK: AgentWindow
    "sessions.layout.singlePaneDetailPanel": false,

    // カラーテーマ関係
    "workbench.colorTheme": "Keivax-zen3",
    "workbench.experimental.modernUIEditorTabStyle": "pill",
    "chat.viewSessions.orientation": "stacked",
}